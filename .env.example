# Google Places API (New)
GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com
GOOGLE_PLACES_CONNECT_TIMEOUT_MILLIS=2000
GOOGLE_PLACES_REQUEST_TIMEOUT_MILLIS=5000
GOOGLE_PLACES_MAX_RESULTS=10
GOOGLE_PLACES_MAX_RETRIES=2
GOOGLE_PLACES_RETRY_BACKOFF_MILLIS=200

# Google Routes API
GOOGLE_ROUTES_ENABLED=false
GOOGLE_ROUTES_API_KEY=
GOOGLE_ROUTES_BASE_URL=https://routes.googleapis.com
GOOGLE_ROUTES_CONNECT_TIMEOUT_MILLIS=2000
GOOGLE_ROUTES_REQUEST_TIMEOUT_MILLIS=5000
GOOGLE_ROUTES_MAX_RETRIES=2
GOOGLE_ROUTES_RETRY_BACKOFF_MILLIS=200
GOOGLE_ROUTES_MAX_ELEMENTS_PER_PLAN=120
GOOGLE_ROUTES_CACHE_TTL_SECONDS=1800
GOOGLE_ROUTES_CACHE_MAX_ENTRIES=200

# OpenAI Responses API for AI itinerary revisions
OPENAI_AI_REVISION_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_AI_REVISION_MODEL=gpt-6-luna
OPENAI_AI_REVISION_REASONING_EFFORT=low
OPENAI_CONNECT_TIMEOUT_MILLIS=2000
OPENAI_REQUEST_TIMEOUT_MILLIS=15000
OPENAI_MAX_RETRIES=2
OPENAI_RETRY_BACKOFF_MILLIS=200
OPENAI_AI_REVISION_MAX_OUTPUT_TOKENS=1200
OPENAI_AI_REVISION_MAX_COMMANDS=5
OPENAI_AI_REVISION_MAX_PROMPT_CHARACTERS=30000
